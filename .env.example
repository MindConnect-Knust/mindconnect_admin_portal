VITE_APP_ENV=production
VITE_API_URL=https://mind-connect-backend-wg2b.onrender.com/api
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Staging and production builds must set VITE_API_URL to their explicit public
# HTTPS API endpoint in the deployment environment. The client fails closed.
# For local development, use an untracked .env.local with:
#   VITE_APP_ENV=development
#   VITE_API_URL=http://localhost:5000/api
# Development refuses the production API (src/services/http.js) and, without
# VITE_API_URL, defaults to the local backend.
